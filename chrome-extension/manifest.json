{
  "manifest_version": 3,
  "name": "poof recorder",
  "version": "0.1.0",
  "description": "录制网页会话(rrweb 语义事件流)送进 poof,给 AI 回放/读。P2.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_popup": "popup.html", "default_title": "poof 录像" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/rrweb.umd.js", "src/recorder-core.js", "src/page-injector.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
